# direnv configuration for agora project
# Provides development environment with all necessary tools and LSP
use flake

# Load .env.local if it exists (for secrets and local overrides)
if [ -f .env.local ]; then
  dotenv .env.local
fi

# Export helpful variables
export PROJECT_ROOT="$(pwd)"
export BUN_INSTALL="$PROJECT_ROOT/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Set up Node environment
export NODE_ENV="development"

# Create .bun directory if it doesn't exist
mkdir -p "$BUN_INSTALL"

# Helpful message on load
echo "✓ agora development environment loaded"
echo "  - Bun package manager"
echo "  - Node.js runtime"
echo "  - Docker & Docker Compose"
echo "  - TypeScript LSP"
