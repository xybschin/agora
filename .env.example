# Copy this to .env.local and fill in your values
# This file is excluded from git for security

# Node environment
NODE_ENV=development

# Docker settings (optional)
# DOCKER_BUILDKIT=1
# COMPOSE_DOCKER_CLI_BUILD=1

# LLM Provider settings (used by agents)
# LLM_API_KEY=your_key_here
# LLM_API_BASE=https://api.openai.com/v1  # or other provider

# Matrix settings (optional, usually set by bootstrap)
# MATRIX_HOME_SERVER_URL=
# MATRIX_SETUP_ACCESS_TOKEN=

# Development settings
# DEBUG=false
# LOG_LEVEL=info
