node_modules/
dist/
*.tsbuildinfo

/logs/*
!/logs/.gitkeep

/runner-generated/*
!/runner-generated/.gitkeep

credentials.yaml
readers.local.yaml
.env
.env.local
settings.local.json

# direnv / nix-direnv generated local state
.direnv/

# Local toolchain / issue-tracker state
.bun/
.beads/

# Synapse's runtime state: signing key, media, secrets, logs. Owned by uid 991
# once Synapse boots; its tracked config lives in docker/matrix/synapse-config/.
docker/matrix/synapse/*

# Postgres data volume. The infra compose mounts it under docker/matrix/, so
# that is the path that has to match -- the bare docker/postgres-data line
# below never matched anything and left the live database in git's sights.
docker/matrix/postgres-data
docker/postgres-data

.venv/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads.gate.lock
flake.lock
.claude/worktrees/*
